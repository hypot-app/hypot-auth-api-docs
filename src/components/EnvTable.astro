---
// Renders one group of config/env-vars.mjs as a table. The same list is checked against the API by test/api/config.test.js.
import { envGroups } from '../../config/env-vars.mjs';

interface Props {
  group: string;
}

const { group } = Astro.props;
const found = envGroups.find((candidate) => candidate.id === group);
if (!found) throw new Error(`Unknown env group "${group}"`);

const escapeHtml = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// `text` fragments between backticks become <code>.
const inline = (text: string) =>
  text
    .split('`')
    .map((part, index) => (index % 2 === 1 ? `<code>${escapeHtml(part)}</code>` : escapeHtml(part)))
    .join('');
---

<table>
  <thead>
    <tr>
      <th>Variable</th>
      <th>Obligatoria</th>
      <th>Por defecto</th>
      <th>Regla</th>
      <th>Descripción</th>
    </tr>
  </thead>
  <tbody>
    {
      found.vars.map((variable) => (
        <tr>
          <td><code>{variable.name}</code></td>
          <td>{variable.required ? 'Sí' : 'No'}</td>
          <td>{variable.default === null ? '—' : <code>{variable.default}</code>}</td>
          <td set:html={inline(variable.rule)} />
          <td set:html={inline(variable.description)} />
        </tr>
      ))
    }
  </tbody>
</table>
